{
  # Select the controller's OS disk before installation; all its data is erased.
  disko.devices.disk.os = {
    type = "disk";
    device = "/dev/disk/by-id/REPLACE_WITH_CONTROLLER_OS_DISK";
    content = {
      type = "gpt";
      partitions = {
        ESP = {
          size = "1G";
          type = "EF00";
          content = {
            type = "filesystem";
            format = "vfat";
            mountpoint = "/boot";
            mountOptions = [ "umask=0077" ];
          };
        };
        root = {
          size = "100%";
          content = {
            type = "filesystem";
            format = "ext4";
            mountpoint = "/";
          };
        };
      };
    };
  };
}
